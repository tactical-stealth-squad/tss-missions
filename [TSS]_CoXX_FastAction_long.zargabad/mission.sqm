					property="ModuleCreateDiaryRecord_F_Description";
					expression="_this setVariable ['Description',_value,true];";
					class Value
					{
						class data
						{
							singleType="STRING";
							value="Die TSS Einheiten sind zusammen mit einem Platoon der US Army in einem Grenzvorposten südlich von Zargabad stationiert. Das HVT befindet sich in der Villa nordöstlich von Zargabad. Gesamt Zargabad ist unter der Kontrolle des takistanischen Militärs. Aus dem Militärlager im Norden von Zargabad ist mit Verstärkung zu rechnen. Der Flughafen sowie die Villa werden ebenfalls durch das takistanische Militär stark bewacht.  Das HVT reist zusammen mit zwei Söldnern, welche rund um die Uhr an seiner Seite sind. Des Weiteren wurde beobachtet, dass vor zwei Tage mehrer Zivilisten in die Villa gebracht wurden und seit dem nicht mehr gesichtet wurden. Es wird davon ausgegangen, dass es sich dabei um drei der vor einer Woche verschwundenen Gruppe von Mitgliedern der demokratischen Partei Takistans handelt.</br>" \n "<br>" \n "Minenlage:<br>" \n "Das gesamte Gebiet ist Mienen und IED frei.<br>" \n "<br>" \n "";
