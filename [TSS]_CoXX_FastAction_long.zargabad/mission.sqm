		class Item73
		{
			dataType="Logic";
			class PositionInfo
			{
				position[]={3349.158,21.895927,645.65698};
			};
			id=890;
			type="ModuleCreateDiaryRecord_F";
			class CustomAttributes
			{
				class Attribute0
				{
					property="ModuleCreateDiaryRecord_F_PresetTitle";
					expression="_this setVariable ['PresetTitle',_value,true];";
					class Value
					{
						class data
						{
							singleType="STRING";
							value="Situation";
						};
					};
				};
				class Attribute1
				{
					property="ModuleCreateDiaryRecord_F_Title";
					expression="_this setVariable ['Title',_value,true];";
					class Value
					{
						class data
						{
							singleType="STRING";
							value="";
						};
					};
				};
				class Attribute2
				{
					property="ModuleCreateDiaryRecord_F_Description";
					expression="_this setVariable ['Description',_value,true];";
					class Value
					{
						class data
						{
							singleType="STRING";
							value="Nach den Demonstrationen des Arabischen Frühlings, der Stürzung und dem Zusammenbruch der Diktatur, langen Kämpfen um die politische Macht, ist vor etwa drei Jahren Ruhe in das Land eingekehrt. Die ersten demokratischen Wahlen wurden ausgetragen und der Wiederaufbau wurde mit Hilfe ausländischen Geldern stark vorangetrieben. Aufgrund der Instabilität und den fortlaufenden Auseinandersetzungen in den angrenzenden Ländern, hatte die Regierung bei der NATO um Hilfe bei der Grenzsicherung gebeten, um zu verhindern, dass Terrorgruppen und Milizen der jungen Demokratie schaden. Teile des TSS wurden in der Grenzregion Zargabad mit der Grenzkontrolle beauftragt. " \n "<br>" \n "<br>" \n "Durch den plötzlichen Tod des ersten Präsidenten kam es zu Neuwahlen und ein neuer autokratischer Präsident wurde gewählt mit dem sich auch die politische Struktur erneut änderte. Er kündigte zum Ende des nächsten Jahres die Unterstützung der NATO auf und öffnete die durch das lokale Militär bewachte Grenzen für Terroristen und Waffenschmuggler, da diese viel Geld in das Land brachten. Die NATO entsandten Truppen halten sich nachwievor an den Auftrag die Grenzen vor den oben genannten Gruppen zu schützen. Durch die entgegengesetzte Grenzpolitik kam es bereits mehrmals zu Auseinandersetzungen zwischen NATO Truppen und dem lokalen Militär. Die NATO entschied sich somit vor einer Woche, das Mandat selbständig aufzukündigen und den Abzug der NATO Truppen einzuleiten. Der Abzug wird schnell vorangetrieben, da die Angriffe seitens des lokalen Militärs immer häufiger auftreten. " \n "<br>" \n "<br>" \n "Das NATO Oberkommando entschied, dass vor dem Abzug aber noch möglichst viele Hintermänner gefangen genommen werden sollen. In der Region Zargabad hält sich bereits seit mehreren Wochen ein Söldner auf, der laut Intel schon bei einigen Regierungsstürzungen in Afrika eine wichtige Rolle gespielt haben soll. Es wird davon ausgegangen, dass er auch den neuen Präsidenten aktiv unterstützt.";
						};
					};
				};
				class Attribute3
				{
					property="ModuleCreateDiaryRecord_F_Owner";
					expression="_this setVariable ['Owner',_value,true];";
					class Value
					{
						class data
						{
							singleType="SCALAR";
							value=3;
						};
					};
