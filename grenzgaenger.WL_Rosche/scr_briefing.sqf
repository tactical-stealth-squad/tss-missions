private _diary6 = player createDiaryRecord ["Diary", ["Anmerkungen", "
• Gruppenführer und Truppführer führen zusätzlich ein SEM70 sowie eine LAW mit.<br/>
• Die über Codewörter übermittelte Rettungsfrequenz ist nach Missionsbeginn im Ingame-Briefing zu finden.<br/>
• Teleport-Dixi am Flughafen.<br/>
• Briefing und Einleitungstext unter Zuhilfenahme von Perplexity.<br/>
